# ============================================================
# Advanced SOC Lab — Environment Configuration
# ============================================================
# Copy this file to .env before running:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# It is already listed in .gitignore.
# ============================================================


# ── REACT APP (READ AT BUILD TIME) ───────────────────────────
# All frontend env vars MUST be prefixed REACT_APP_
# If backends are unreachable the UI falls back to mock data.

REACT_APP_USE_MOCK_DATA=true
REACT_APP_REFRESH_INTERVAL_MS=8000

# ── WAZUH ────────────────────────────────────────────────────
REACT_APP_WAZUH_HOST=https://192.168.56.10:55000
REACT_APP_WAZUH_USER=wazuh-wui
REACT_APP_WAZUH_PASS=replace-with-wazuh-password

WAZUH_HOST=https://192.168.56.10:55000
WAZUH_USER=wazuh-wui
WAZUH_PASS=replace-with-wazuh-password
WAZUH_INDEXER_PASS=replace-with-wazuh-indexer-password

# ── ELASTICSEARCH / WAZUH INDEXER ────────────────────────────
ES_HOST=https://192.168.56.10:9200
ES_USER=admin
ES_PASS=replace-with-elasticsearch-password

# ── THEHIVE ──────────────────────────────────────────────────
REACT_APP_THEHIVE_HOST=http://192.168.56.10:9000
THEHIVE_HOST=http://192.168.56.10:9000
THEHIVE_API_KEY=replace-with-thehive-api-key
THEHIVE_SECRET=replace-with-thehive-secret

# ── CORTEX ───────────────────────────────────────────────────
REACT_APP_CORTEX_HOST=http://192.168.56.10:9001
CORTEX_HOST=http://192.168.56.10:9001
CORTEX_API_KEY=replace-with-your-cortex-api-key

# ── MISP ─────────────────────────────────────────────────────
REACT_APP_MISP_HOST=https://192.168.56.10:8443
MISP_HOST=https://192.168.56.10:8443
MISP_ADMIN_EMAIL=admin@soc.lab
MISP_ADMIN_PASSPHRASE=replace-with-misp-passphrase
MISP_API_KEY=replace-with-your-misp-auth-key
MISP_DB_PASS=replace-with-misp-db-password
MISP_DB_ROOT_PASS=replace-with-misp-root-password

# ── THREAT INTELLIGENCE APIs ──────────────────────────────────
# AbuseIPDB — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=replace-with-abuseipdb-api-key

# VirusTotal — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=replace-with-virustotal-api-key

# AlienVault OTX — https://otx.alienvault.com/api
OTX_API_KEY=replace-with-your-otx-key

# Shodan — https://account.shodan.io
SHODAN_API_KEY=replace-with-your-shodan-key

# Minimum AbuseIPDB score to flag as malicious (0-100)
MALICIOUS_THRESHOLD=50

# ── OPENAI (AI SOC ASSISTANT) ────────────────────────────────
# Get key at: https://platform.openai.com/api-keys
REACT_APP_OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1000

# ── NOTIFICATIONS ─────────────────────────────────────────────
# Slack incoming webhook
# Create at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK=replace-with-slack-webhook


# Microsoft Teams incoming webhook
TEAMS_WEBHOOK=https://outlook.office.com/webhook/REPLACE/WITH/YOUR/WEBHOOK

# SMTP email
SMTP_HOST=smtp.soc.lab
SMTP_PORT=587
SMTP_USER=soc-alerts@soc.lab
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=SOC Alerts <soc-alerts@soc.lab>

# ── FIREWALL AUTOMATION ──────────────────────────────────────
PFSENSE_HOST=https://192.168.56.1
PFSENSE_USER=admin
PFSENSE_PASS=replace-with-pfsense-password

# ── BACKUP ───────────────────────────────────────────────────
BACKUP_ROOT=/opt/soc-backups
RETENTION_DAYS=30

# ── VULNERABILITY MANAGEMENT ─────────────────────────────────
GVM_HOST=localhost
GVM_PORT=9390
GVM_USER=admin
GVM_PASS=replace-with-gvm-password
REPORT_DIR=/opt/soc-reports/vulnerability

# ── GENERAL ──────────────────────────────────────────────────
TIMEZONE=UTC
LOG_LEVEL=INFO
BLOCK_LOG_FILE=/var/log/soc-blocked-ips.json
NODE_ENV=development